{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "ink": { "$value": "#16222E", "$type": "color", "$description": "Brand ink — icon tile, dark surface, headings on light" },
    "night": { "$value": "#10161D", "$type": "color", "$description": "Darkest ground — page background in dark mode" },
    "cloud-slate": { "$value": "#33536F", "$type": "color", "$description": "Cloud fill on dark surfaces" },
    "cloud-mist": { "$value": "#C4D8EA", "$type": "color", "$description": "Cloud fill on light surfaces" },
    "signal": {
      "on-dark": { "$value": "#5FB8FF", "$type": "color", "$description": "Primary accent on dark grounds" },
      "on-light": { "$value": "#1273C4", "$type": "color", "$description": "Primary accent on light grounds — AA on white" }
    },
    "cursor-glow": {
      "on-dark": { "$value": "#8FD0FF", "$type": "color" },
      "on-light": { "$value": "#3E97DF", "$type": "color" }
    },
    "text": {
      "primary-on-light": { "$value": "#16222E", "$type": "color" },
      "body-on-light": { "$value": "#33465A", "$type": "color" },
      "muted-on-light": { "$value": "#54718A", "$type": "color" },
      "primary-on-dark": { "$value": "#DCEBF8", "$type": "color" },
      "body-on-dark": { "$value": "#A9C2D8", "$type": "color" },
      "muted-on-dark": { "$value": "#7FA8C9", "$type": "color" }
    },
    "surface": {
      "bg-light": { "$value": "#F4F8FC", "$type": "color" },
      "card-light": { "$value": "#FFFFFF", "$type": "color" },
      "line-light": { "$value": "#D5E2EE", "$type": "color" },
      "bg-dark": { "$value": "#10161D", "$type": "color" },
      "card-dark": { "$value": "#16222E", "$type": "color" },
      "line-dark": { "$value": "#24384C", "$type": "color" },
      "accent-soft-light": { "$value": "#E3F0FB", "$type": "color" },
      "accent-soft-dark": { "$value": "#1A2E42", "$type": "color" }
    },
    "semantic": {
      "success": { "$value": "#2E9E6B", "$type": "color" },
      "warning": { "$value": "#C08A2D", "$type": "color" },
      "danger": { "$value": "#C9564A", "$type": "color" }
    }
  },
  "font": {
    "mono": { "$value": "'JetBrains Mono', ui-monospace, 'Cascadia Code', 'SF Mono', Menlo, Consolas, monospace", "$type": "fontFamily", "$description": "Brand voice — wordmark, headings, labels, code" },
    "sans": { "$value": "system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily", "$description": "Body text — the mono is flavor, body stays quiet" }
  },
  "typography": {
    "display": { "$value": { "fontFamily": "{font.mono}", "fontWeight": 700, "fontSize": "34px", "letterSpacing": "-0.03em" }, "$type": "typography" },
    "heading": { "$value": { "fontFamily": "{font.mono}", "fontWeight": 700, "fontSize": "18px", "letterSpacing": "-0.01em" }, "$type": "typography" },
    "label": { "$value": { "fontFamily": "{font.mono}", "fontWeight": 400, "fontSize": "12px", "letterSpacing": "0.15em", "textTransform": "uppercase" }, "$type": "typography" },
    "body": { "$value": { "fontFamily": "{font.sans}", "fontWeight": 400, "fontSize": "16px", "lineHeight": 1.6 }, "$type": "typography" },
    "code": { "$value": { "fontFamily": "{font.mono}", "fontWeight": 400, "fontSize": "14px" }, "$type": "typography" }
  },
  "dimension": {
    "space": {
      "1": { "$value": "4px", "$type": "dimension" },
      "2": { "$value": "8px", "$type": "dimension" },
      "3": { "$value": "12px", "$type": "dimension" },
      "4": { "$value": "16px", "$type": "dimension" },
      "5": { "$value": "24px", "$type": "dimension" },
      "6": { "$value": "40px", "$type": "dimension" },
      "7": { "$value": "64px", "$type": "dimension", "$description": "Scale ≈ ×φ from step 5" }
    },
    "radius": {
      "control": { "$value": "6px", "$type": "dimension", "$description": "Buttons, inputs" },
      "card": { "$value": "10px", "$type": "dimension" },
      "tile": { "$value": "21.875%", "$type": "dimension", "$description": "Icon tile corner = 7/32 of tile size" }
    }
  },
  "motion": {
    "cursor-blink": { "$value": { "duration": "1.1s", "timingFunction": "steps(1)", "iterations": "infinite" }, "$type": "transition", "$description": "The one sanctioned brand animation — the loader cursor" },
    "hover": { "$value": { "duration": "120ms", "timingFunction": "ease-out" }, "$type": "transition" }
  },
  "geometry": {
    "phi": { "$value": 1.618033988749895, "$type": "number", "$description": "Golden ratio — cloud radii progression r, r√φ, rφ; mark box φ:1; chevron apex at (1−1/φ)·w" }
  }
}
