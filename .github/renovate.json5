// Dependency automation, run by the hosted Renovate GitHub App that already
// serves overcast-sh/overcast and overcast-sh/website (website's
// .github/renovate.json5 is the template for this file).
//
// The App runs in Silent mode for this org: it scans every repository but only
// acts on one that carries its own config, and it never opens an onboarding
// PR. This repository had been "onboarded" but never "activated" in the Mend
// portal for that reason. This file is the activation.
//
// The policy, shared with website:
//   - Majors are never grouped: a breaking change (Storybook, React, Vite) is
//     a decision and arrives as its own PR with the major visible.
//   - Non-major updates are grouped per ecosystem — one PR for the npm tree,
//     one for the workflow actions — to keep review cheap and CI runs few.
//   - Nothing is automerged. The main-branch ruleset requires no status check
//     at all, so an automerge would merge on nothing. Every PR waits for a
//     human, and here that human has a real job — see the drift note below.
//   - Nothing younger than seven days is taken (`minimumReleaseAge`).
//   - Open PRs are kept rebased on `main` rather than only when they
//     conflict, so a regenerated package-lock.json is always true of the base
//     it will merge into.
//   - The dependency dashboard issue (on by way of config:recommended) lists
//     everything pending or deliberately not taken, so "no PR" is visible
//     rather than silent.
//
// One thing is specific to this repository. Everything visual is generated,
// and CI's "Generated assets in sync" job rebuilds it all and fails if the
// committed outputs differ. A bump of @resvg/resvg-js, opentype.js or
// png-to-ico can legitimately change the generated bytes — a rasteriser
// rounds differently, a font-parsing fix moves a glyph — and then the
// Renovate PR fails that job by design. Renovate cannot regenerate the assets
// itself (the hosted App does not run postUpgradeTasks), so the reviewer
// does: check out the branch, `npm run build && node
// design-system/react/embed.mjs`, look at the pixel diff, commit. A drift
// failure on a Renovate PR is information about the rendering pipeline, not
// a broken update.
//
// Commit messages here are plain imperative sentences, not conventional
// commits, so `semanticCommits` is off.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // The workflow's actions are pinned by tag today. This preset is the
    // org's policy from overcast: the first Renovate PR here converts the
    // tag pins to digest pins (with the tag kept as a comment), and any
    // action added by tag later gets the same treatment.
    'helpers:pinGitHubActionDigests',
  ],

  enabledManagers: ['npm', 'github-actions'],

  semanticCommits: 'disabled',

  minimumReleaseAge: '7 days',

  // Every dependency here is declared as a caret range, and Renovate's
  // default for npm ranges is to leave a range alone while the newest
  // version still satisfies it — which for `^10.5.4` is every 10.x, so
  // nothing short of a major would ever produce a PR and the lockfile would
  // advance only through the monthly lockFileMaintenance. `bump` moves the
  // range's floor to the version actually installed, so each non-major
  // update is a visible, reviewable PR and package.json says what is really
  // in use.
  rangeStrategy: 'bump',

  // Vulnerability fixes bypass the schedule, the grouping and the age floor:
  // a fix is wanted on day zero. OSV needs no GitHub feature to be enabled.
  osvVulnerabilityAlerts: true,

  // Weekly, early Monday UTC, matching the other repositories.
  schedule: ['* 0-8 * * 1'],

  rebaseWhen: 'behind-base-branch',

  // A monthly full regeneration of package-lock.json, for the transitive
  // pins that no direct bump ever reaches.
  lockFileMaintenance: {
    enabled: true,
    schedule: ['* 0-8 1 * *'],
  },

  packageRules: [
    {
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'npm dependencies (non-major)',
    },
    {
      // Storybook's CLI, framework and addon packages are released in
      // lockstep and refuse to load when they disagree. Move them together
      // across every update type, majors included.
      matchManagers: ['npm'],
      matchPackageNames: ['storybook', '@storybook/**'],
      groupName: 'storybook',
    },
    {
      // react and react-dom must match majors, and the type packages track
      // them. Same treatment.
      matchManagers: ['npm'],
      matchPackageNames: ['react', 'react-dom', '@types/react', '@types/react-dom'],
      groupName: 'react',
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      groupName: 'github actions (non-major)',
    },
  ],
}
