{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["esnext", "dom"]
  },
  "include": ["*.ts", "*.mts", "design-system/**/*.ts", ".storybook/**/*.ts", "stories/**/*.ts", "stories/**/*.tsx"]
}
